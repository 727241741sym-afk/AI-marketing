{
  "name": "atlas-research-saas",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "lint:web": "npm --workspace apps/web run lint",
    "test:web": "node --test apps/web/src/lib/*.test.mjs",
    "test:api": "cd apps/api && .venv\\Scripts\\python.exe -m pytest tests -q",
    "test": "npm run test:web && npm run test:api"
  }
}
